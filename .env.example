# =========================
# MAGIZH SERVER
# =========================
PORT=8787
JWT_SECRET=replace-with-a-long-random-secret

# Local development: leave DATABASE_URL empty to use SQLite.
# Production: set this to your Render/PostgreSQL connection string.
DATABASE_URL=
# DATABASE_SSL=false   # only if your PostgreSQL provider explicitly requires no SSL
DB_PATH=./data/magizh.db

# If frontend is hosted separately (e.g. Vercel), set its exact origin here.
# Example: FRONTEND_ORIGIN=https://magizh.vercel.app
FRONTEND_ORIGIN=

# =========================
# OLLAMA
# =========================
# Local development:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_API_KEY=
#
# Production / Ollama Cloud:
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b-cloud
OLLAMA_API_KEY=

# =========================
# ELEVENLABS
# =========================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
