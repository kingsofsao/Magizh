# =========================
# MAGIZH SERVER
# =========================
PORT=8787

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Local development: leave DATABASE_URL empty to use SQLite.
# Production: set this to your PostgreSQL connection string.
DATABASE_URL=
# DATABASE_SSL=false   # only if your PostgreSQL provider explicitly requires no SSL
DB_PATH=./data/magizh.db

# Only needed if the frontend is hosted on a different origin (e.g. Vercel).
# Example: FRONTEND_ORIGIN=https://magizh.vercel.app
FRONTEND_ORIGIN=

# =========================
# OLLAMA
# =========================
# Local development (Ollama running on this machine):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_API_KEY=
#
# Production / Ollama Cloud (use these instead on the server):
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=gpt-oss:20b-cloud
# OLLAMA_API_KEY=<ollama-cloud-api-key>

# =========================
# ELEVENLABS (voice mode, optional)
# =========================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
